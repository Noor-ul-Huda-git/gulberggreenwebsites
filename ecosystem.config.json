{
  "apps": [
    {
      "name": "gulberg-backend",
      "cwd": "./backend",
      "script": ".venv/bin/python",
      "interpreter": "none",
      "args": [
        "-m",
        "gunicorn",
        "--bind",
        "127.0.0.1:8000",
        "--workers",
        "3",
        "--timeout",
        "120",
        "--access-logfile",
        "-",
        "--error-logfile",
        "-",
        "config.wsgi:application"
      ]
    },
    {
      "name": "gulberg-frontend",
      "cwd": "./frontend",
      "script": "npm",
      "args": ["run", "preview", "--", "--host", "127.0.0.1", "--port", "5173"],
      "autorestart": true
    }
  ]
}
