{
  "apps": [
    {
      "name": "gulberg-backend",
      "cwd": "./backend",
      "script": "manage.py",
      "interpreter": "python3",
      "args": ["runserver", "127.0.0.1:8000"]
    },
    {
      "name": "gulberg-frontend",
      "cwd": "./frontend",
      "script": "npm",
      "args": ["run", "preview", "--", "--host", "127.0.0.1", "--port", "5173"],
      "autorestart": true
    }
  ]
}
