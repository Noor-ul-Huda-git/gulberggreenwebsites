# Copy to backend/.env — never commit .env

# --- Local SQLite (default for new clones — no Tailscale needed) ---
# DJANGO_DB_ENGINE=sqlite
# DJANGO_DEBUG=True
# DJANGO_SECRET_KEY=local-dev-only-change-me
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Shared prod DB via Tailscale (editors) — see deploy/mysql/TAILSCALE-DEV.md ---
# DJANGO_DB_ENGINE=mysql
# MYSQL_DATABASE=gulberg
# MYSQL_USER=gulberg_editor
# MYSQL_PASSWORD=ask-admin
# MYSQL_HOST=100.96.37.12
# MYSQL_PORT=3306
# DJANGO_DEBUG=True
# DJANGO_SECRET_KEY=local-dev-only-change-me
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional: homepage YouTube API feed (/api/youtube/videos/) — RSS on Home works without this
# YOUTUBE_API_KEY=
